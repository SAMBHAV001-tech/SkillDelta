# ──────────────────────────────────────────────────────────────────────────────
# SkillDelta Frontend — Environment Variables
# Copy this file to .env.local for local development
# On Vercel: add these as Environment Variables in the Vercel project settings
# ──────────────────────────────────────────────────────────────────────────────

# Backend API base URL
# Local development:
VITE_API_URL=http://localhost:7860
# Production (Hugging Face Spaces):
# VITE_API_URL=https://<your-hf-username>-skilldelta-backend.hf.space
